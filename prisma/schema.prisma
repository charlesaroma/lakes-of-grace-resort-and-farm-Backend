generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

// ─── Enums ───

enum UserRole {
  staff
  admin
  manager
  system_developer
  front_desk
  kitchen_view
  housekeeper_mobile
}

enum AreaOfStay {
  Standard
  Deluxe
  Premium
}

enum BoardPlan {
  FULL
  HALF
  BnB
}

enum OccupancyType {
  Single
  Double_Couple
  Double_Twin
  Shared_3Bed
  Shared_4Bed
}

enum ViewCategory {
  Panorama
  Lakeview
  Weaverbird
  Mulungi
  Forest
  Orchard
}

enum RoomStatus {
  Available
  Occupied
  Maintenance
  Reserved
}

enum LeadStatus {
  new
  contacted
  converted
}

enum ReviewStatus {
  Published
  Pending
  Rejected
}

enum StockLedgerType {
  restock
  dispatch
  adjustment
}

enum MenuStatus {
  Active
  Inactive
}

enum InquiryStatus {
  New
  Read
  Replied
  Closed
}

enum AuditLogSeverity {
  Info
  Warning
  Security
  Error
}

enum EntityType {
  User
  Booking
  Lead
  System
  Payment
  Stock
  Menu
  Guest
  Media
  Inquiry
  TagConfig
  Room
  Review
  CheckIn
  Guideline
  ConferenceHall
  Notification
  Staff
}

// ─── Models ───

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("staff")
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  lastLogoutAll DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockLedgers      StockLedger[]
  auditLogs         AuditLog[]
  housekeeperZones  ZoneHousekeeper[] @relation("HousekeeperRelation")
  managedZones      ZoneHousekeeper[] @relation("ManagerRelation")
  staffProfile      Staff?

  @@map("users")
}

model Department {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  color       String   @default("bg-gray-100 text-gray-700")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("departments")
}

model Staff {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  photo        String?
  department   String
  position     String?
  employedDate DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String? @unique @db.ObjectId
  userAccount User? @relation(fields: [userId], references: [id])

  @@map("staff")
}

model Booking {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  guestName         String
  guestEmail        String
  areaOfStay        String?
  occupancy         String?
  occupancyDetails  String?
  boardType         String?
  checkIn           DateTime
  checkOut          DateTime
  guests            Int      @default(1)
  status            String   @default("Pending")
  totalAmount       Float    @default(0)
  paymentMethod     String?
  pesapalTrackingId String?
  phone             String?
  specialRequests   String?
  bookingType       String   @default("Individual")
  rooms             String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checkIns CheckIn[]

  @@index([areaOfStay, checkIn])
  @@index([guestEmail, status])
  @@map("bookings")
}

model Room {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  roomNumber          String   @unique
  roomName            String?
  areaOfStay          String   @default("Standard")
  viewCategory        String?
  status              String   @default("Available")
  occupancyTypes      String[] 
  capacity            Int      @default(2)
  isStaffResidence    Boolean  @default(false)
  isVipSuite          Boolean  @default(false)
  isOutOfInventory    Boolean  @default(false)
  housekeeper         String?
  manager             String?
  customFullBoardRate Float?
  customHalfBoardRate Float?
  customBnBRate       Float?
  description         String?
  amenities           String[]
  images              String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("rooms")
}

model Guest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  phone         String?
  totalBookings Int      @default(0)
  lastStay      DateTime?
  totalSpend    Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("guests")
}

model Review {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName     String   @default("")
  lastName      String   @default("")
  email         String?
  rating        Int
  title         String?
  comment       String?
  response      String?
  status        String   @default("Published")
  showOnHomePage Boolean @default(false)
  images        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, showOnHomePage, createdAt])
  @@map("reviews")
}

model Evaluation {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName            String   @default("")
  lastName             String   @default("")
  gender               String?
  phone                String?
  email                String?
  physicalAddress      String?
  country              String?
  arrivalDate          String?
  arrivalTime          String?
  departureDate        String?
  departureTime        String?
  occupancy            String?
  numberOfChildren     Int?
  referralSource       String?
  staffPerformance     String?
  accommodations       String?
  propertyEnvironment  String?
  diningCatering       String?
  recreationSafety     String?
  frontDeskOperations  String?
  generalComments      String?
  suggestions          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([email, arrivalDate])
  @@map("evaluations")
}

model CheckIn {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  guestName        String
  guestPhone       String
  roomNumber       String
  bookingId String? @db.ObjectId
  checkInTime      DateTime
  expectedCheckOut DateTime
  actualCheckOut   DateTime?
  status           String   @default("Checked-In")
  idProof          String?
  notes            String?
  vehicleNumber    String?
  numberOfGuests   Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status, bookingId])
  @@map("check_ins")
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  type      String    @default("Info")
  category  String    @default("General")
  link      String?
  isRead    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isRead, type, createdAt])
  @@map("notifications")
}

model StockItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  item      String   @unique
  category  String
  quantity  Int      @default(0)
  unit      String   @default("pieces")
  threshold Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLedgers StockLedger[]

  @@map("stock_items")
}

model StockLedger {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId     String @db.ObjectId
  item       String
  type       String   @default("restock")
  quantity   Int
  balance    Int
  cost       Float    @default(0)
  supplier   String?
  department String?
  purpose    String?
  reason     String?
  note       String?
  userId     String? @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stockItem StockItem @relation(fields: [itemId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([itemId, createdAt])
  @@map("stock_ledgers")
}

model MenuItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  category  String
  price     String?
  status    String   @default("Active")
  description String?
  group     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, status])
  @@map("menu_items")
}

model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("inquiries")
}

model Media {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  fileId    String   @unique
  tag       String?
  size      String?
  alt       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tag, createdAt])
  @@map("media")
}

model TagConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tag_configs")
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  action     String
  details    String?
  entityType String
  entityId   String?
  actorId    String? @db.ObjectId
  actorName  String?
  changes    Json?
  severity   String   @default("Info")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

model RoomPricingRule {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  areaOfStay     String
  occupancyType  String
  boardPlan      String
  pricePerNight  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([areaOfStay, occupancyType, boardPlan])
  @@map("room_pricing_rules")
}

model ZoneHousekeeper {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  viewCategory  String   @unique
  housekeeperId String   @db.ObjectId
  managerId     String?  @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  housekeeper   User     @relation("HousekeeperRelation", fields: [housekeeperId], references: [id])
  manager       User?    @relation("ManagerRelation", fields: [managerId], references: [id])

  @@map("zone_housekeepers")
}

model ImageCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("image_categories")
}
